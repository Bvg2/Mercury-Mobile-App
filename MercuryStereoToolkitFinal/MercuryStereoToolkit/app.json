{
  "expo": {
    "name": "MercuryStereoToolkit",
    "slug": "MercuryStereoToolkitLite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mercSymbol.png",
    "scheme": "mercurystereotoolkitlite",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mercSymbol.png",
      "imageWidth": 200,
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mercurycamera.MercuryStereoToolkitLite",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/androidIconFinal.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mercurycamera.MercuryStereoToolkitLite"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mercSymbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df2a8673-7a2e-47bf-be39-89aa1b750f3e"
      }
    }
  }
}
